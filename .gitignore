# =============================================================================
# FluxDrop — .gitignore
# =============================================================================
# Philosophy:
#   Secrets and credentials  → always ignored
#   Build inputs (source)    → always committed
#   Build outputs (TestWeb)  → committed (this repo IS the deployment package;
#                               sync_to_server.sh rsync's TestWeb/ directly)
#   Generated bundles        → committed (fd_locale_bundle.js, tailwindcss.css)
#   Tool configs (.vscode/)  → committed (tasks.json is project-specific)
# =============================================================================


# ── Secrets & credentials ─────────────────────────────────────────────────────
# The entire secrets/ directory is ignored.  The sibling secrets_samples/ dir
# is NOT inside secrets/ — it's a separate committed directory of safe templates.
# (The old rule "!server/Web/secrets/samples" was pointing at a path that does
# not exist and had no effect.)
server/Web/secrets/

# Local deploy config — fill in deploy.env.sample to create this locally
deploy.env

# Belt-and-suspenders: catch private key files if they ever land outside secrets/
*.key
*.pem
# Exception: the sample key/cert files in secrets_samples/ are safe stubs —
# git will still ignore them only if they're inside secrets/, which they aren't;
# secrets_samples/ is committed in full.


# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/


# ── Node / Tailwind build tooling ─────────────────────────────────────────────
node_modules/
# ↑ DO NOT add package-lock.json here.  It records the exact dependency tree
#   with integrity hashes and ensures every `npm install` produces the same
#   node_modules.  Ignoring it was a bug in the old .gitignore.


# ── OS & editor noise ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
*.swp
*.swo
*~


# ── Generic env files ─────────────────────────────────────────────────────────
# deploy.env is already covered above.  This catches any other plain .env
# or *.local.env files that might be created later.
.env
*.local.env


# ── Caches ───────────────────────────────────────────────────────────────────
.cache/
.backup/


# ── Temporary scratch files ───────────────────────────────────────────────────
temp.py
temp.md


# ── WIP server scripts (not yet updated to match current codebase) ────────────
# Remove this line once server/Web/scripts/ is back in working order.
server/Web/scripts/


# ── Runtime server data ───────────────────────────────────────────────────────
# server/files/ is an empty runtime data directory — nothing in there should
# ever be committed.
server/files/


# =============================================================================
# What is intentionally NOT ignored — and why
# =============================================================================
#
# .vscode/
#   tasks.json contains the project's build tasks (Ctrl+Shift+B, locale check,
#   etc.).  These are project-specific, not personal, so committing them
#   benefits anyone who works on the project — including future-you on a fresh
#   machine.  Personal preferences (font, theme, Python interpreter path) go
#   in VS Code's User Settings, not in the workspace .vscode/settings.json.
#   If you do put personal settings in .vscode/settings.json, add this line:
#       .vscode/settings.json
#
# package-lock.json
#   Locks npm dependency versions for reproducible builds.  Always commit it.
#
# server/TestWeb/
#   The deployed build artifacts.  build.sh writes here; sync_to_server.sh
#   pushes this directory to the server via rsync.  Committing it means a
#   fresh clone can be deployed immediately without running the build step.
#
# server/TestWeb/fluxdrop_pp/tailwindcss.css
#   Generated by Tailwind but needed for the app to work.  Committed as part
#   of the deployment package.  Git diffs on it are noise but the file is
#   small (~30 KB minified) and deployment simplicity wins.
#
# server/build/src/fluxdrop_pp/fd_locale_bundle.js
#   Generated by build.sh (build_locale_bundle.py) but committed alongside the
#   locale JSON files.  The GitHub Actions check-locales workflow warns when
#   it's stale.  Committing it means the bundle is always available for rsync
#   without requiring Python on the deployment machine.
#
# server/Web/secrets_samples/
#   Safe placeholder files — sample configs and empty credential templates.
#   Committed so a fresh clone shows what each secrets file should look like.

/server/TestWeb/tilesna_practyka
/server/Web/tilesna_api.py
/server/services/tilesna_api.service
# This is temporary site for a friend, hosted on my server until we'll get a 
# proper hardware+software