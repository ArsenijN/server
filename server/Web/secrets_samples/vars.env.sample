# --- Required: set these for your own server ---
# PUBLIC_DOMAIN=example.com
# SERVE_ROOT=/srv/fluxdrop/cdn
# SERVE_DIRECTORY=/srv/fluxdrop/site/TestWeb
# Temp dir for upload chunks; a different drive than SERVE_ROOT (ideally an
# SSD) lets chunks go straight into the destination file, see README.
# UPLOAD_TMP_DIR=/mnt/ssd/fluxdrop_upload_sessions

# Anything else for the variables
# For example:

# Ports. The front servers (server_http.py / server_https.py) read
# FRONT_HTTP_PORT / FRONT_HTTPS_PORT (defaults 8080 / 8443). HTTP_PORT /
# HTTPS_PORT are the CDN's (63512 / 64800) — and the front servers' fallback,
# so setting them here without the FRONT_ ones makes two servers bind them.
# FRONT_HTTP_PORT=8080
# FRONT_HTTPS_PORT=8443
# LOG_FILE_HTTP='home/arsen/servers/self-host/site/Web/logs.txt'
# UPLOAD_CHUNK_SIZE=26214400

# This amount of chunk size is kinda the best since it doesn't degrade server 
# speeds (on low-end hardware at least, but also not that large so it's not 
# overheading on chunk corruption)

# --- Logging verbosity ---
# When unset or 0 (default), routine static-file GET requests are NOT written
# to the CDN access log, reducing per-request I/O overhead on low-end hardware.
# API, auth, share, and /healthz requests are always logged regardless.
# Set to 1 to restore full per-request access logging (useful for debugging).
# DEBUG_LOGGING=0
# --- Data retention (keep in sync with the Privacy Policy) ---
# Days of server logs kept; logs rotate daily at midnight.
# LOG_RETENTION_DAYS=90
# Days a deleted account's files wait in FluxDrop/.deleted_accounts before
# they're permanently removed.
# DELETED_ACCOUNT_PURGE_DAYS=30

# --- Storage quotas ---
# Disk space kept free: uploads, copies and tar streams are refused once only
# this much is left. The larger of the two is used.
# QUOTA_RESERVE_GB=20
# QUOTA_RESERVE_PCT=2

# --- CatBox API (/user/api.php) ---
# Kill switch: 0 refuses all API requests (uploads, deletes); files already
# uploaded stay downloadable. Needs a CDN restart.
# CATBOX_API_ENABLED=1

# --- ZIP folder downloads ---
# Seconds without a status poll from the browser (it polls every second)
# before a ZIP job stops hashing; hashes done so far are kept and the job
# continues when polled again. Kept above a few seconds because browsers
# throttle timers in background tabs.
# ZIP_JOB_IDLE_STOP=20

# --- HTTPS server ---
# Max worker threads (created only when needed). Each keep-alive connection
# holds one for up to 45 s; Immich opens ~60 at once while scrolling.
# HTTPS_MAX_WORKERS=400

# --- Background hash scanner (see _bg_crc32_scanner in server_cdn.py) ---
# Scan window in UTC hours (20-1 = 23:00-04:00 EEST)
# BG_SCAN_START_UTC=20
# BG_SCAN_END_UTC=1
# Throttle, bytes per second, and read buffer size
# BG_SCAN_RATE_BYTES=5242880
# BG_SCAN_READ_BUF=2097152
# Also scan outside the window while the server is idle; gap between passes
# BG_SCAN_IDLE=1
# BG_SCAN_IDLE_RESCAN_S=21600
# Pause while the 1-min load average per CPU core is above this
# BG_SCAN_MAX_LOAD=0.5
# BG_SCAN_NICE=19
