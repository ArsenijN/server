# Anything else for the variables
# For example:

# HTTP_PORT='8080'
# HTTPS_PORT='8443'
# LOG_FILE_HTTP='home/arsen/servers/self-host/site/Web/logs.txt'
# UPLOAD_CHUNK_SIZE=26214400

# This amount of chunk size is kinda the best since it doesn't degrade server 
# speeds (on low-end hardware at least, but also not that large so it's not 
# overheading on chunk corruption)

# --- Logging verbosity ---
# When unset or 0 (default), routine static-file GET requests are NOT written
# to the CDN access log, reducing per-request I/O overhead on low-end hardware.
# API, auth, share, and /healthz requests are always logged regardless.
# Set to 1 to restore full per-request access logging (useful for debugging).
# DEBUG_LOGGING=0
# --- Data retention (keep in sync with the Privacy Policy) ---
# Days of server logs kept; logs rotate daily at midnight.
# LOG_RETENTION_DAYS=90
# Days a deleted account's files wait in FluxDrop/.deleted_accounts before
# they're permanently removed.
# DELETED_ACCOUNT_PURGE_DAYS=30
