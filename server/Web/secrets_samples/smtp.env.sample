# Sample SMTP configuration for outgoing mail (account verification, upload
# notifications, content-report alerts).
# Copy this file to ../smtp.env and fill in real values.

# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587                  # 587 = STARTTLS, 465 = implicit TLS
# SMTP_SENDER_EMAIL=noreply@fluxdrop.me
# SMTP_SENDER_PASSWORD=your-app-password-or-api-key
#
# Login name, if it differs from the sender address. Transactional providers
# usually need this (Resend: "resend", Brevo: your account login, Amazon SES:
# the SMTP user id). Leave unset for Gmail / Proton, where it's the address.
# SMTP_USERNAME=
#
# SMTP_SENDER_NAME=FluxDrop      # shown as: FluxDrop <noreply@fluxdrop.me>
# SMTP_REPLY_TO=support@fluxdrop.me

# Public contact address (policies, report page) and where new content-report
# alerts are sent (REPORT_NOTIFY_EMAIL defaults to CONTACT_EMAIL).
# CONTACT_EMAIL=privacy@fluxdrop.me
# REPORT_NOTIFY_EMAIL=
